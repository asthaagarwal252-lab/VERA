# Local: http://localhost:8000 | Vercel: /api
VITE_API_BASE_URL=http://localhost:8000
VITE_CONTRACT_ADDRESS=
VITE_PROOF_ARTIFACT_BASE_URL=/artifacts
VITE_DEFAULT_NETWORK=preview
ENVIRONMENT=production
ALLOWED_HOSTS=your-vercel-domain.vercel.app,localhost,127.0.0.1
CORS_ORIGINS=https://your-vercel-domain.vercel.app
RATE_LIMIT_PER_MINUTE=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@YOUR-POOLED-HOST/DB?ssl=require
DATABASE_DIRECT_URL=postgresql+asyncpg://USER:PASSWORD@YOUR-DIRECT-HOST/DB?ssl=require
